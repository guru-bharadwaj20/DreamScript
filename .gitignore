# --- environments -----------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- data: tracked by DVC, never committed raw ------------------------------
# The contents stay out of git; the .dvc pointer files are exactly what git *should*
# carry, so they are re-included below.
data/raw/*
data/interim/*
data/processed/*
data/features/*
!data/raw/*.dvc
!data/interim/*.dvc
!data/processed/*.dvc
!data/features/*.dvc

# --- experiment outputs -----------------------------------------------------
experiments/*
mlruns/

# --- model weights ----------------------------------------------------------
*.pt
*.pth
*.onnx
*.safetensors

# --- secrets ----------------------------------------------------------------
.env

# --- keep the directory skeleton itself -------------------------------------
!**/.gitkeep
.venv-labelstudio/
labeling/tasks/

# Phase 13 batch CLI output
runs/
